{
    "name": "admin-ui",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "workspaces": [
        "packages/*"
    ],
    "scripts": {
        "prepare": "git config core.hooksPath .githooks",
        "lib:dev": "npm run dev -w @paya-labs/admin-ui",
        "lib:build": "npm run build -w @paya-labs/admin-ui",
        "lib:test": "npm run test -w @paya-labs/admin-ui",
        "lib:test:watch": "npm run test:watch -w @paya-labs/admin-ui",
        "demo:dev": "npm run build -w @paya-labs/admin-ui && npm run dev -w demo",
        "demo:build": "npm run build -w demo",
        "lint": "prettier --check . && eslint .",
        "lint:fix": "prettier --write . && eslint . --fix"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@typescript-eslint/eslint-plugin": "^8.58.1",
        "@typescript-eslint/parser": "^8.53.1",
        "@vitejs/plugin-vue": "^6.0.5",
        "eslint": "^10.2.0",
        "eslint-plugin-vue": "^10.8.0",
        "globals": "^17.4.0",
        "prettier": "^3.8.1",
        "prettier-plugin-organize-imports": "^4.3.0",
        "prettier-plugin-tailwindcss": "^0.7.2",
        "typescript": "^6.0.2",
        "vite": "npm:rolldown-vite@7.2.5",
        "vite-plugin-dts": "^4.5.4",
        "vite-plugin-vue-devtools": "^8.1.1",
        "vue": "^3.5.32"
    },
    "overrides": {
        "vite": "npm:rolldown-vite@7.2.5",
        "minimatch": "^10.2.4",
        "eslint-scope": "^9.1.2"
    },
    "dependencies": {
        "vue-tsc": "^3.2.6"
    }
}
