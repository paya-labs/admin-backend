{
    "name": "admin-ui",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "workspaces": [
        "packages/*"
    ],
    "scripts": {
        "prepare": "git config core.hooksPath .githooks",
        "lib:dev": "npm run dev -w @paya-labs/admin-ui",
        "lib:build": "npm run build -w @paya-labs/admin-ui",
        "lib:test": "npm run test -w @paya-labs/admin-ui",
        "lib:test:watch": "npm run test:watch -w @paya-labs/admin-ui",
        "demo:dev": "npm run build -w @paya-labs/admin-ui && npm run dev -w demo",
        "demo:build": "npm run build -w demo",
        "lint": "vp fmt --check . && vp lint .",
        "lint:fix": "vp fmt . && vp lint . --fix"
    },
    "devDependencies": {
        "@vitejs/plugin-vue": "^6.0.7",
        "typescript": "^6.0.3",
        "vite": "npm:@voidzero-dev/vite-plus-core@8.3.8000",
        "vite-plugin-dts": "^5.0.2",
        "vite-plugin-vue-devtools": "^8.1.2",
        "vue": "^3.5.43",
        "vite-plus": "1.7.0"
    },
    "overrides": {
        "vite": "npm:@voidzero-dev/vite-plus-core@8.3.8000",
        "minimatch": "^11.0.1",
        "glob": "^14.0.2"
    },
    "dependencies": {
        "vue-tsc": "^3.3.4"
    }
}
