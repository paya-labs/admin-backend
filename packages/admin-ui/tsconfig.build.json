{
    "extends": "../../tsconfig.json",
    "compilerOptions": {
        "ignoreDeprecations": "6.0",
        "noEmit": false,
        "declaration": true,
        "declarationMap": true,
        "emitDeclarationOnly": true,
        "rootDir": "./src",
        "outDir": "./dist/types",
        "skipLibCheck": true
    },
    "include": ["src/**/*.ts", "src/**/*.vue"],
    "exclude": ["node_modules", "dist", "tests", "**/*.test.ts", "**/*.spec.ts"]
}
