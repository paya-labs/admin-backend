{
    "name": "@paya-labs/admin-ui",
    "version": "0.0.11",
    "description": "Vue 3 admin UI components for building backoffice applications",
    "type": "module",
    "main": "./dist/admin-ui.umd.cjs",
    "module": "./dist/admin-ui.js",
    "types": "./dist/admin-ui.d.ts",
    "exports": {
        ".": {
            "types": "./dist/admin-ui.d.ts",
            "import": "./dist/admin-ui.js",
            "require": "./dist/admin-ui.umd.cjs"
        },
        "./styles": "./dist/admin-ui.css",
        "./themes/base.css": "./src/themes/base.css"
    },
    "files": [
        "dist",
        "src"
    ],
    "scripts": {
        "dev": "vite build --watch",
        "build": "vite build",
        "test": "vitest run",
        "test:watch": "vitest",
        "lint": "prettier --check . && eslint .",
        "lint-fix": "prettier --write . && eslint . --fix"
    },
    "peerDependencies": {
        "vue": "^3.5.0",
        "vue-router": "^5.0.7"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.3.0",
        "@vitejs/plugin-vue": "^6.0.7",
        "@vue/test-utils": "^2.4.10",
        "jsdom": "^29.1.1",
        "tailwindcss": "^4.1.0",
        "vite": "npm:rolldown-vite@7.2.5",
        "vitest": "^4.1.6"
    },
    "keywords": [
        "vue",
        "vue3",
        "admin",
        "ui",
        "components",
        "backoffice",
        "dashboard"
    ],
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/flangofas/admin-ui.git"
    },
    "publishConfig": {
        "registry": "https://npm.pkg.github.com"
    },
    "dependencies": {
        "@fullcalendar/core": "^6.1.20",
        "@fullcalendar/daygrid": "^6.1.20",
        "@fullcalendar/interaction": "^6.1.20",
        "@fullcalendar/list": "^6.1.20",
        "@fullcalendar/timegrid": "^6.1.20",
        "@fullcalendar/vue3": "^6.1.20",
        "@tiptap/markdown": "^3.23.4",
        "@tiptap/pm": "^3.23.4",
        "@tiptap/starter-kit": "^3.23.4",
        "@tiptap/vue-3": "^3.23.4"
    }
}
